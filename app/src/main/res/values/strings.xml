    <!-- Onboarding -->
    <string name="onboard_title_1">Welcome to PathSathi</string>
    <string name="onboard_desc_1">Your automatic travel companion for treks — offline-first, so it works even with no signal on the trail.</string>
    <string name="onboard_title_2">Live GPS Tracking</string>
    <string name="onboard_desc_2">Track your route, speed, and elevation automatically. Tracking keeps running even if you lock your phone.</string>
    <string name="onboard_title_3">Safety First</string>
    <string name="onboard_desc_3">SOS calling, safety check-ins, route-deviation alerts, and nearby emergency help — all built in.</string>
    <string name="onboard_title_4">Automatic Weather</string>
    <string name="onboard_desc_4">Live weather, multi-day forecasts, and safety alerts for wherever your trek takes you.</string>
    <string name="onboard_setup_title">One-time setup</string>
    <string name="onboard_setup_desc">PathSathi needs a couple of permissions to keep you safe on the trail.</string>
