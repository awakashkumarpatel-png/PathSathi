    <!-- Onboarding -->
    <string name="onboard_title_1">PathSathi में आपका स्वागत है</string>
    <string name="onboard_desc_1">ट्रेक के लिए आपका स्वचालित यात्रा साथी — ऑफ़लाइन-फर्स्ट, ताकि ट्रेल पर सिग्नल न होने पर भी काम करे।</string>
    <string name="onboard_title_2">लाइव GPS ट्रैकिंग</string>
    <string name="onboard_desc_2">अपना रूट, स्पीड और ऊँचाई अपने आप ट्रैक करें। फ़ोन लॉक होने पर भी ट्रैकिंग चलती रहती है।</string>
    <string name="onboard_title_3">सुरक्षा सबसे पहले</string>
    <string name="onboard_desc_3">SOS कॉलिंग, सेफ्टी चेक-इन, रूट-डिविएशन अलर्ट, और आस-पास की इमरजेंसी मदद — सब कुछ शामिल है।</string>
    <string name="onboard_title_4">स्वचालित मौसम</string>
    <string name="onboard_desc_4">लाइव मौसम, कई दिनों का पूर्वानुमान, और आपके ट्रेक के लिए सुरक्षा अलर्ट।</string>
    <string name="onboard_setup_title">एक बार की सेटअप</string>
    <string name="onboard_setup_desc">आपको सुरक्षित रखने के लिए PathSathi को कुछ अनुमतियों की ज़रूरत है।</string>
    <string name="permission_location_title">लोकेशन</string>
