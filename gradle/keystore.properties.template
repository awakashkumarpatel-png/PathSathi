# Copy this file to "keystore.properties" (same folder) and fill in real
# values before building a release you intend to publish. Never commit the
# real keystore.properties or the .jks/.keystore file itself.
#
# To generate a new upload keystore (needs a JDK - run this in Termux or
# any machine with `keytool` available, NOT in this sandbox):
#
#   keytool -genkey -v -keystore pathsathi-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias pathsathi
#
# Then fill in the path/passwords below. storeFile is resolved relative to
# the project root (the folder containing settings.gradle).

storeFile=gradle/pathsathi-release.jks
storePassword=CHANGE_ME
keyAlias=pathsathi
keyPassword=CHANGE_ME
